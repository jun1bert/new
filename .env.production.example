APP_NAME="Shafer's Skin Lovers Lounge"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://studio.example.com

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_shafers
DB_USERNAME=cpaneluser_shafers
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
# Synchronous delivery avoids needing a persistent queue worker on shared hosting.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_USERNAME=bookings@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=bookings@example.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
